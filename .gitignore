node_modules/
.next/
out/
build/
.env
.env.local
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts
.DS_Store

# HTTPS: Zertifikate und private Schlüssel gehören dem einzelnen Server und
# niemals ins Repository. Ebenso die Nachweisdateien von Let's Encrypt.
docker/gateway/zertifikate/
docker/gateway/acme/
# Der eingeschaltete 443-Block ist Sache der jeweiligen Maschine: ohne
# passendes Zertifikat startet nginx damit nicht. Die Vorlage wird versioniert.
docker/gateway/tls/*.conf

# PlatformIO
firmware/**/.pio/
firmware/**/.vscode/
firmware/**/include/geheimnisse.h

# Datenbanksicherungen - gehoeren nicht ins Repository
/sicherung/

# Zertifikate der Sensoren. Der CA-Schluessel darf den Server nie verlassen -
# wer ihn hat, stellt sich beliebige Geraeteausweise aus.
# Erzeugt von scripts/geraete-zertifikate.sh
docker/mqtt/geraete/
docker/mqtt/geraete-ca/
