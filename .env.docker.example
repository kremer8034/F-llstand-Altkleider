# ===========================================================================
# Einstellungen für den Betrieb mit Docker
#
#   cp .env.docker.example .env
#   node scripts/schluessel-erzeugen.mjs >> .env     # Schlüssel erzeugen
#   docker compose --profile dev up -d --build
#
# Diese Datei enthält nach dem Ausfüllen Zugangsdaten und gehört NICHT ins
# Repository (.env steht bereits in .gitignore).
# ===========================================================================

# --- Adressen --------------------------------------------------------------
# Unter dieser Adresse ist alles erreichbar: Karte, interner Bereich und die
# Schnittstelle für die Sensoren. Bei einem eigenen Server hier die echte
# Adresse eintragen, z. B. https://fuellstand.brk-mill.de
OEFFENTLICHE_URL=http://localhost:8080

PORT_EXTERN=8080
PORT_MAIL=8025
PORT_STUDIO=8000

# --- Schlüssel -------------------------------------------------------------
# Alle fünf Werte erzeugt `node scripts/schluessel-erzeugen.mjs`.
POSTGRES_PASSWORD=
AUTH_ADMIN_PASSWORT=
AUTHENTICATOR_PASSWORT=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Werksschlüssel für die Erstinbetriebnahme der Sensoren (openssl rand -hex 32)
GERAETE_PROVISIONIERUNG_SCHLUESSEL=

# Zweiter Annahmeweg für Fertiggeräte, z. B. Milesight EM400-TLD.
# Sie können unser Signaturverfahren nicht und weisen sich mit diesem
# gemeinsamen Schlüssel aus (docs/em400-tld.md). Leer = Weg ist zu.
INGEST_WEBHOOK_TOKEN=

# Schützt den stündlichen Prüflauf
CRON_SECRET=

# --- E-Mail ----------------------------------------------------------------
# Voreingestellt ist der Testempfänger "mail" aus dem Profil dev
# (Postfach unter http://localhost:8025). Für den echten Betrieb den
# Hausmailserver eintragen und das Profil dev weglassen.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_BENUTZER=
SMTP_PASSWORT=
SMTP_ABSENDER=noreply@brk-mill.de
SMTP_ABSENDERNAME=Füllstand Altkleidercontainer

# --- Sonstiges -------------------------------------------------------------
# "ja" spielt beim ersten Start zehn Beispielcontainer ein.
BEISPIELDATEN=nein
